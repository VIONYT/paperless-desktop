{
	"name": "paperless-desktop",
	"version": "0.1.0",
	"description": "Desktop app (native Apple Silicon) that uses the paperless-ngx API to manage your documents",
	"main": "main.js",
	"scripts": {
		"build": "node build.js",
		"start": "node build.js --dev && electron .",
		"test": "node --test test/*.test.js && npm run lint",
		"lint": "eslint .",
		"package": "node build.js && node package.js",
		"package:mac:arm64": "node build.js && node package.js --arch=arm64",
		"package:mac:universal": "node build.js && node package.js --arch=universal",
		"package:debug": "node build.js --dev && node package.js --arch=arm64 --debug",
		"prepare": "husky || true"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thomasbrueggemann/paperless-desktop.git"
	},
	"dependencies": {
		"alt": "^0.17.4",
		"axios": "^1.7.9",
		"pdfjs-dist": "^6.5.438",
		"prop-types": "^15.5.8",
		"react": "^16.14.0",
		"react-dom": "^16.14.0",
		"react-router": "^3.0.2",
		"react-select": "^1.0.0-rc.3",
		"underscore": "^1.8.3"
	},
	"devDependencies": {
		"@babel/core": "^8.1.0",
		"@babel/plugin-transform-classes": "^8.1.0",
		"@electron/fuses": "^2.1.3",
		"@electron/packager": "^20.3.0",
		"@eslint/js": "^10.0.1",
		"electron": "^45.2.3",
		"esbuild": "^0.28.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.10",
		"pretty-quick": "^4.2.2"
	},
	"keywords": [
		"paperless",
		"desktop",
		"electron"
	],
	"author": "Thomas Brüggemann",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/thomasbrueggemann/paperless-desktop/issues"
	},
	"homepage": "https://github.com/thomasbrueggemann/paperless-desktop#readme",
	"prettier": {
		"printWidth": 100,
		"useTabs": true,
		"tabWidth": 4,
		"arrowParens": "always",
		"trailingComma": "none"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"overrides": {
		"minimatch": "^11.0.5",
		"glob": "^14.0.4"
	}
}
