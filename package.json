{
	"name": "paperless-desktop",
	"version": "0.1.0",
	"description": "Desktop app (native Apple Silicon) that uses the paperless-ngx API to manage your documents",
	"main": "main.js",
	"scripts": {
		"build": "node build.js",
		"start": "node build.js && electron .",
		"test": "npm run lint",
		"lint": "eslint js/src",
		"precommit": "pretty-quick --staged",
		"package": "node build.js && electron-packager ./ Paperless --platform=darwin --arch=arm64,x64 --out ./build --overwrite --icon=./icon --ignore='^/(build$|icon.psd$|js/src)'",
		"package:mac:arm64": "node build.js && electron-packager ./ Paperless --platform=darwin --arch=arm64 --out ./build --overwrite --icon=./icon --ignore='^/(build$|icon.psd$|js/src)'",
		"package:mac:universal": "node build.js && electron-packager ./ Paperless --platform=darwin --arch=universal --out ./build --overwrite --icon=./icon --ignore='^/(build$|icon.psd$|js/src)'",
		"package:debug": "node build.js && touch debug.flag && electron-packager ./ 'Paperless Debug' --platform=darwin --arch=arm64 --out ./build --overwrite --icon=./icon --ignore='^/(build$|icon.psd$|js/src)'; rm -f debug.flag"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thomasbrueggemann/paperless-desktop.git"
	},
	"dependencies": {
		"@electron/remote": "^2.1.2",
		"alt": "^0.17.4",
		"axios": "^1.7.9",
		"electron-dl": "^3.5.2",
		"jquery": "^3.5.0",
		"moment": "^2.29.2",
		"prop-types": "^15.5.8",
		"react": "^15.4.1",
		"react-big-calendar": "^0.13.0",
		"react-dom": "^15.4.1",
		"react-file-drop": "^0.1.8",
		"react-pure-render": "^1.0.2",
		"react-router": "^3.0.2",
		"react-select": "^1.0.0-rc.3",
		"react-waypoint": "^6.0.0",
		"riek": "^1.0.7",
		"underscore": "^1.8.3"
	},
	"devDependencies": {
		"@babel/core": "^8.1.0",
		"@babel/plugin-transform-classes": "^8.1.0",
		"@electron/packager": "^20.3.0",
		"electron": "^45.2.3",
		"esbuild": "^0.28.0",
		"eslint": "^5.1.0",
		"eslint-config-prettier": "^2.9.0",
		"eslint-plugin-react": "^7.10.0",
		"husky": "^0.14.3",
		"prettier": "^1.13.7",
		"pretty-quick": "^1.6.0"
	},
	"keywords": [
		"paperless",
		"desktop",
		"electron"
	],
	"author": "Thomas Brüggemann",
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/thomasbrueggemann/paperless-desktop/issues"
	},
	"homepage": "https://github.com/thomasbrueggemann/paperless-desktop#readme",
	"prettier": {
		"printWidth": 100,
		"useTabs": true,
		"tabWidth": 4,
		"arrowParens": "always"
	},
	"engines": {
		"node": ">=22.12.0"
	}
}
